<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force: the tests always use these, never a value from .env (the real databases, the mailer). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:V7ByWubBKyHn3x1cKFkJ5SwTfHzHpwM1CJt+wN13fmc=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_GLOBAL_DRIVER" value="sqlite" force="true"/>
        <env name="DB_GLOBAL_DATABASE" value=":memory:" force="true"/>
        <!-- SQLite's CURRENT_TIMESTAMP is UTC. -->
        <env name="DB_GLOBAL_CLOCK_TIMEZONE" value="UTC" force="true"/>
        <env name="PASSWORD_ARGON2_MEMORY_KIB" value="1024" force="true"/>
        <env name="PASSWORD_ARGON2_ITERATIONS" value="1" force="true"/>
        <env name="PASSWORD_ARGON2_PARALLELISM" value="1" force="true"/>
        <env name="PASSWORD_MIN_LENGTH" value="8" force="true"/>
        <env name="PASSWORD_MAX_LENGTH" value="64" force="true"/>
        <env name="DISCORD_GUILD_ID" value="" force="true"/>
        <env name="REGISTRATION_CODE_LENGTH" value="6" force="true"/>
        <env name="REGISTRATION_CODE_EXPIRES_MINUTES" value="15" force="true"/>
        <env name="REGISTRATION_CODE_MAX_ATTEMPTS" value="5" force="true"/>
        <env name="RATE_LIMITS_REGISTER_PER_MINUTE" value="5" force="true"/>
        <env name="RATE_LIMITS_REGISTER_PER_HOUR" value="20" force="true"/>
        <env name="RATE_LIMITS_REGISTER_VERIFY_PER_MINUTE" value="10" force="true"/>
        <env name="RATE_LIMITS_REGISTRATION_MAIL_COOLDOWN_SECONDS" value="60" force="true"/>
        <env name="RATE_LIMITS_LOGIN_PER_MINUTE" value="5" force="true"/>
        <env name="RATE_LIMITS_LOGIN_PER_MINUTE_PER_IP" value="20" force="true"/>
        <env name="RATE_LIMITS_PASSWORD_CHANGE_PER_MINUTE" value="5" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173" force="true"/>
        <env name="TRUSTED_PROXIES" value="127.0.0.1" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
    </php>
</phpunit>
