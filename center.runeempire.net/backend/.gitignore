# Laravel backend. AI tools, editors and OS files are in the repository's root .gitignore.

# Dependencies
/vendor

# Local configuration and secrets (.env.example is the committed template)
.env
.env.backup
.env.production
/auth.json

# Logs, caches and generated files
*.log
.phpunit.result.cache
/.phpunit.cache
/public/storage
/storage/*.key
/storage/pail
_ide_helper.php
.phpactor.json

# Homestead
Homestead.json
Homestead.yaml
