# RuneEmpire Center backend configuration.
#
# Copy this file to .env and fill it in; .env is not committed.
# A real environment variable with the same name overrides the value here.
# Lists (TRUSTED_PROXIES, SANCTUM_STATEFUL_DOMAINS) are comma-separated.

# --- App ---------------------------------------------------------------------

APP_NAME="RuneEmpire Center"
# local | production
APP_ENV=local
# Always false in production.
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with: php artisan key:generate
APP_KEY=

# --- Redis (sessions) --------------------------------------------------------

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Only sessions use this index. The Redis instance is shared (Pterodactyl,
# LuckPerms, ...): pick an index nothing else uses, and never share it with
# a cache store (cache:clear flushes the whole index).
REDIS_DB=3

# --- Session -----------------------------------------------------------------

# redis, or file for a machine without phpredis.
SESSION_DRIVER=redis
# Minutes of inactivity before the login expires.
SESSION_LIFETIME=120
# Production: set true. Unset (as in dev) means automatic, which marks the
# cookie Secure only when the request is seen as HTTPS through a correctly
# trusted proxy; a wrong TRUSTED_PROXIES value would silently drop it.
# Never false in production.
# SESSION_SECURE_COOKIE=true

# Website origins that get session login and CSRF protection.
# Production: center.runeempire.net
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Proxies whose X-Forwarded-For / -Proto is trusted (Cloudflare Tunnel's cloudflared).
# If the backend runs in Docker, this is the bridge gateway (e.g. 172.18.0.1), not 127.0.0.1.
TRUSTED_PROXIES=127.0.0.1

# --- Databases ---------------------------------------------------------------

# The website's own database on the mysql-web server (127.0.0.1:3954 on the
# server, next to Pterodactyl and LeonorStyle): Laravel's tables (cache, rate
# limits, API tokens), the pending registrations, later the shop's data.
# Create it empty, grant it to the web user, then: php artisan migrate
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3954
DB_DATABASE=Center
DB_USERNAME=web
DB_PASSWORD=

# The network's shared mysql-global server (127.0.0.1:3951 on the server):
# its Auth database holds the accounts (shared with the game's auth plugin)
# and RuneAuth's account_locks. The website creates no tables there: its user
# needs only SELECT, INSERT, UPDATE on Auth.accounts and SELECT on Auth.account_locks.
DB_GLOBAL_DRIVER=mysql
DB_GLOBAL_HOST=127.0.0.1
DB_GLOBAL_PORT=3951
DB_GLOBAL_DATABASE=Auth
DB_GLOBAL_USERNAME=global
DB_GLOBAL_PASSWORD=
# The MySQL server's own clock (TZ of its container): accounts.created_at is in it.
DB_GLOBAL_CLOCK_TIMEZONE=Europe/Budapest
# The game plugins' databases on the same server, read through the user above
# (it needs SELECT on each).
DB_SKINRESTORER_DATABASE=SkinRestorer
DB_RUNEACTIVITY_DATABASE=RuneActivity
DB_PLAYERPOINTS_DATABASE=PlayerPoints
DB_LUCKPERMS_DATABASE=LuckPerms
DB_LITEBANS_DATABASE=LiteBans
DB_RUNEFRIENDS_DATABASE=RuneFriends
# The time zone RuneActivity counts its days and weeks in (its config.yml `timezone`).
RUNEACTIVITY_TIMEZONE=Europe/Budapest

# No background jobs yet; run them inline.
QUEUE_CONNECTION=sync

# --- Passwords ---------------------------------------------------------------

# argon2id, which the game's auth plugin verifies at the in-game /login.
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_ARGON2_MEMORY_KIB=131072
PASSWORD_ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=8
# At most 128: the longest password the in-game /login accepts (a chat line holds 256 characters).
PASSWORD_MAX_LENGTH=64

# --- Mail --------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo SMTP login (Resend: "resend").
MAIL_USERNAME=
# Brevo SMTP key (Resend: API key; host smtp.resend.com).
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mail.runeempire.net
MAIL_FROM_NAME=RuneEmpire

# --- Two-factor authentication (2FA) ----------------------------------------

# 32 bytes, standard Base64: MUST be RuneAuth's twofa.secret-key, or 2FA players cannot log in
# to the game. Empty or invalid: 2FA can be neither switched on nor checked (2FA accounts get
# "not available now", never a password-only login). Make a local one with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Never put the production key on a development machine.
TWOFA_SECRET_KEY=
# The name authenticator apps list the account under.
TWOFA_ISSUER=RuneEmpire

# --- Registration ------------------------------------------------------------

# Digits, 4-12.
REGISTRATION_CODE_LENGTH=6
# Minutes; empty, 0 or not a number -> 15.
REGISTRATION_CODE_EXPIRES_MINUTES=15
# 1-255; empty, 0 or not a number -> 5.
REGISTRATION_CODE_MAX_ATTEMPTS=5

# --- Rate limits -------------------------------------------------------------

# POST /api/auth/register, per IP.
RATE_LIMITS_REGISTER_PER_MINUTE=5
RATE_LIMITS_REGISTER_PER_HOUR=20
# POST /api/auth/register/verify, per IP.
RATE_LIMITS_REGISTER_VERIFY_PER_MINUTE=10
# One code per email address and client (IP, IPv6 /64) within this window; also the
# wait between two password reset codes of an account.
RATE_LIMITS_REGISTRATION_MAIL_COOLDOWN_SECONDS=600
# At most this many registration codes to one address per hour, from all clients
# together (no inbox flooding). Keep it above 3600 / the cooldown (6 at 600 s).
RATE_LIMITS_REGISTRATION_MAIL_PER_ADDRESS_PER_HOUR=10
# POST /api/auth/login: per username + IP, and per IP overall.
RATE_LIMITS_LOGIN_PER_MINUTE=5
RATE_LIMITS_LOGIN_PER_MINUTE_PER_IP=20
# PUT /api/auth/password, per account.
RATE_LIMITS_PASSWORD_CHANGE_PER_MINUTE=5
# POST /api/auth/password/forgot (forgotten password, mails a code), per IP.
RATE_LIMITS_PASSWORD_FORGOT_PER_MINUTE=5
RATE_LIMITS_PASSWORD_FORGOT_PER_HOUR=20
# POST /api/auth/password/forgot/verify and /api/auth/password/reset, per IP.
RATE_LIMITS_PASSWORD_RESET_PER_MINUTE=10
# Wrong reset codes per account in 24 hours, whatever number of codes it asked for.
RATE_LIMITS_PASSWORD_RESET_GUESSES_PER_DAY=10
# The 2FA code endpoints (login step, switching on and off), per account (per IP at login).
RATE_LIMITS_TWO_FACTOR_PER_MINUTE=10
# Wrong 2FA codes per account in an hour, at login, switching off and the password reset together.
RATE_LIMITS_TWO_FACTOR_GUESSES_PER_HOUR=10
# GET /api/players/{name}/skin, per IP (a friends list asks for one per friend).
RATE_LIMITS_SKINS_PER_MINUTE=120
# GET /api/players?q= (the Játékosok search), per account.
RATE_LIMITS_PLAYER_SEARCH_PER_MINUTE=60
# GET /api/players/{name}/stats and /friends together, per account (one profile = 2 requests).
RATE_LIMITS_PLAYER_PROFILE_PER_MINUTE=120
# The management area's Google sign-in (redirect and callback together), per account.
RATE_LIMITS_MANAGEMENT_PER_MINUTE=10

# --- Management (Google sign-in) ---------------------------------------------

# The OAuth client from Google Cloud Console (APIs & Services > Credentials).
# Empty client id: the sign-in answers "not set up". Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be one of the client's registered redirect URIs; the path is fixed.
# Production: https://center.runeempire.net/api/management/google/callback
# Development (through the Vite proxy): http://localhost:5173/api/management/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/management/google/callback
# Where the sign-in sends the browser back. Empty: APP_URL (production is one origin).
# Development: the Vite server, http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Minutes of inactivity before the Google sign-in is asked again; 1-120, never longer
# than SESSION_LIFETIME; empty, 0 or not a number -> 30.
MANAGEMENT_SESSION_MINUTES=30

# --- Discord -----------------------------------------------------------------

# The server shown on the overview; turn its widget on in Server settings > Widget.
DISCORD_GUILD_ID=1512369732668362842
