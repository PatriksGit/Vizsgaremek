# RuneEmpire Center backend configuration.
#
# Copy this file to .env and fill it in; .env is not committed.
# A real environment variable with the same name overrides the value here.
# Lists (TRUSTED_PROXIES, SANCTUM_STATEFUL_DOMAINS) are comma-separated.

# --- App ---------------------------------------------------------------------

APP_NAME="RuneEmpire Center"
# local | production
APP_ENV=local
# Always false in production.
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate with: php artisan key:generate
APP_KEY=

# --- Redis (sessions) --------------------------------------------------------

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Only sessions use this index. The Redis instance is shared (Pterodactyl,
# LuckPerms, ...): pick an index nothing else uses, and never share it with
# a cache store (cache:clear flushes the whole index).
REDIS_DB=3

# --- Session -----------------------------------------------------------------

# redis, or file for a machine without phpredis.
SESSION_DRIVER=redis
# Minutes of inactivity before the login expires.
SESSION_LIFETIME=120
# Production: set true. Unset (as in dev) means automatic, which marks the
# cookie Secure only when the request is seen as HTTPS through a correctly
# trusted proxy; a wrong TRUSTED_PROXIES value would silently drop it.
# Never false in production.
# SESSION_SECURE_COOKIE=true

# Website origins that get session login and CSRF protection.
# Production: center.runeempire.net
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Proxies whose X-Forwarded-For / -Proto is trusted (Cloudflare Tunnel's cloudflared).
# If the backend runs in Docker, this is the bridge gateway (e.g. 172.18.0.1), not 127.0.0.1.
TRUSTED_PROXIES=127.0.0.1

# --- Databases ---------------------------------------------------------------

# The website's own database on the mysql-web server (127.0.0.1:3954 on the
# server, next to Pterodactyl and LeonorStyle): Laravel's tables (cache, rate
# limits, API tokens), later the shop's data.
# Create it empty, grant it to the web user, then: php artisan migrate
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3954
DB_DATABASE=Center
DB_USERNAME=web
DB_PASSWORD=

# The network's shared mysql-global server (127.0.0.1:3951 on the server):
# its Auth database belongs to the PAxAuth plugin (accounts); the website adds
# pending_registrations there (php artisan migrate).
DB_GLOBAL_DRIVER=mysql
DB_GLOBAL_HOST=127.0.0.1
DB_GLOBAL_PORT=3951
DB_GLOBAL_DATABASE=Auth
DB_GLOBAL_USERNAME=global
DB_GLOBAL_PASSWORD=
# The MySQL server's own clock (TZ of its container): accounts.created_at is in it.
DB_GLOBAL_CLOCK_TIMEZONE=Europe/Budapest

# No background jobs yet; run them inline.
QUEUE_CONNECTION=sync

# --- Passwords ---------------------------------------------------------------

# Must produce the same hashes PAxAuth verifies (argon2id).
PASSWORD_ARGON2_ITERATIONS=3
PASSWORD_ARGON2_MEMORY_KIB=131072
PASSWORD_ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=8
# Must not exceed PAxAuth's password.max-length, or the player cannot log in in-game.
PASSWORD_MAX_LENGTH=64

# --- Mail --------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo SMTP login (Resend: "resend").
MAIL_USERNAME=
# Brevo SMTP key (Resend: API key; host smtp.resend.com).
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mail.runeempire.net
MAIL_FROM_NAME=RuneEmpire

# --- Registration ------------------------------------------------------------

# Digits, 4-12.
REGISTRATION_CODE_LENGTH=6
REGISTRATION_CODE_EXPIRES_MINUTES=15
# 1-255.
REGISTRATION_CODE_MAX_ATTEMPTS=5

# --- Rate limits -------------------------------------------------------------

# POST /api/auth/register, per IP.
RATE_LIMITS_REGISTER_PER_MINUTE=5
RATE_LIMITS_REGISTER_PER_HOUR=20
# POST /api/auth/register/verify, per IP.
RATE_LIMITS_REGISTER_VERIFY_PER_MINUTE=10
# One code per email address within this window.
RATE_LIMITS_REGISTRATION_MAIL_COOLDOWN_SECONDS=60
# POST /api/auth/login: per username + IP, and per IP overall.
RATE_LIMITS_LOGIN_PER_MINUTE=5
RATE_LIMITS_LOGIN_PER_MINUTE_PER_IP=20
# PUT /api/auth/password, per account.
RATE_LIMITS_PASSWORD_CHANGE_PER_MINUTE=5

# --- Discord -----------------------------------------------------------------

# The server shown on the overview; turn its widget on in Server settings > Widget.
DISCORD_GUILD_ID=1512369732668362842
